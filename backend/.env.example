# Backend environment template — copy to `.env` and fill real values.
# Never commit filled `.env` files.

# Core server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# TigerData / PostgreSQL (PostGIS + TimescaleDB required)
DATABASE_URL=postgresql://user:password@localhost:5432/aethersense

# Redis (BullMQ connection + transient state only)
REDIS_URL=redis://127.0.0.1:6379

# MongoDB (preferences, integration configs, Meko metadata)
MONGODB_URI=mongodb://127.0.0.1:27017/aethersense
MONGODB_DB=aethersense

# Auth — set a real secret in production
JWT_SECRET=dev-secret-change-me

# Write-mode guard for ingestion endpoints. Unset = write endpoints return 503.
INGEST_API_TOKEN=
# Shared secret provider webhooks must present.
WEBHOOK_SHARED_SECRET=

# Meko integration (long-term disaster memory). Unset = memory endpoints
# return a proper "unavailable" response, never fabricated memories.
MEKO_BASE_URL=
MEKO_API_KEY=

# Notification providers: BOTH url and token required to mark a channel
# available; otherwise the router reports "unavailable" honestly.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
PUSH_API_URL=
PUSH_API_TOKEN=

# Dependencies
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment and secrets
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.crt

# Next.js and frontend build output
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/

# Backend build and runtime output
backend/dist/
backend/build/
backend/coverage/
backend/uploads/
backend/tmp/
backend/data/

# Test and coverage output
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/blob-report/

# TypeScript and tooling caches
**/*.tsbuildinfo
.eslintcache
.turbo/
.cache/
.parcel-cache/

# Logs and local runtime files
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Docker local overrides
docker-compose.override.yml
docker-compose.local.yml

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local session and agent artifacts
.copilot/
.claude/
.cursor/
.kilo/*
!.kilo/.gitignore
